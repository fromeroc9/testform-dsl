{
  "Testform Root Manifest Template": {
    "prefix": "testform-init-manifest",
    "body": [
      "version: \"1.0\"",
      "provider: local",
      "backend: local",
      "",
      "variable:",
      "  ${1:app_url}:",
      "    type: string",
      "    description: \"${2:Base application URL}\"",
      "    default: \"${3:https://example.com}\"",
      "",
      "local:",
      "  ${4:base_url}: \"\\${var.${1:app_url}}\"",
      "",
      "resource:",
      "  testcase:",
      "    match: \"*.case.feature\"",
      "    scaffold:",
      "      directory: \"testcase\"",
      "      filename: \"{slug}.case.feature\"",
      "    fields: {}",
      "  testrun:",
      "    match: \"*.run.feature\"",
      "    scaffold:",
      "      directory: \"testrun\"",
      "      filename: \"{slug}.run.feature\"",
      "    fields: {}",
      "  testplan:",
      "    match: \"*.plan.feature\"",
      "    scaffold:",
      "      directory: \"testplan\"",
      "      filename: \"{slug}.plan.feature\"",
      "    fields: {}"
    ],
    "description": "Scaffold a complete Testform root main.yml manifest (v1.1.0-beta.2 format)"
  }
}
