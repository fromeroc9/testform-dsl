{
  "name": "testform-dsl",
  "displayName": "Testform DSL",
  "description": "Declarative Test-as-Code orchestration for Git: Gherkin IntelliSense, variables autoload, native Test Explorer, state management, and quality gates.",
  "version": "1.0.0",
  "publisher": "fromeroc9",
  "license": "GPL-3.0-or-later",
  "author": "Flavio Romero <flavio.arc9@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fromeroc9/testform-extension.git"
  },
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "testform",
    "test-as-code",
    "gherkin",
    "bdd",
    "testing",
    "terraform",
    "qa",
    "test-management"
  ],
  "main": "./dist/client.js",
  "activationEvents": [
    "workspaceContains:**/main.yml",
    "workspaceContains:**/main.yaml",
    "workspaceContains:**/testform.yml",
    "workspaceContains:**/testform.yaml",
    "workspaceContains:**/*.case.feature",
    "workspaceContains:**/*.run.feature",
    "workspaceContains:**/*.plan.feature"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "Cucumber",
          "feature",
          "Cucumber Gherkin"
        ],
        "extensions": [
          ".case.feature",
          ".run.feature",
          ".plan.feature",
          ".feature"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/cucumber.svg",
          "dark": "./assets/cucumber.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gherkin",
        "scopeName": "source.feature",
        "path": "./syntaxes/testform-dsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gherkin",
        "path": "./snippets/gherkin.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "main.yml",
          "main.yaml",
          "testform.yml",
          "testform.yaml",
          "variable.yml",
          "variable.yaml",
          "variables.yml",
          "variables.yaml",
          "locals.yml",
          "locals.yaml",
          "resource.yml",
          "resource.yaml",
          "data.yml",
          "data.yaml",
          "output.yml",
          "output.yaml",
          "**/main.yml",
          "**/main.yaml",
          "**/testform.yml",
          "**/testform.yaml",
          "**/variable.yml",
          "**/variable.yaml",
          "**/locals.yml",
          "**/resource.yml",
          "**/output.yml"
        ],
        "url": "./schemas/testform.schema.json"
      },
      {
        "fileMatch": [
          "*.vars.yml",
          "*.vars.yaml",
          "**/*.vars.yml",
          "**/*.vars.yaml"
        ],
        "url": "./schemas/variables.schema.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "main.yml",
          "main.yaml",
          "testform.yml",
          "testform.yaml",
          "variable.yml",
          "variable.yaml",
          "locals.yml",
          "resource.yml",
          "output.yml"
        ],
        "url": "./schemas/testform.schema.json"
      },
      {
        "fileMatch": [
          "*.vars.yml",
          "*.vars.yaml",
          "**/*.vars.yml",
          "**/*.vars.yaml"
        ],
        "url": "./schemas/variables.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testform-sidebar",
          "title": "Testform",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "testform-sidebar": [
        {
          "id": "testform.views.state",
          "name": "State Explorer",
          "icon": "$(database)"
        },
        {
          "id": "testform.views.modules",
          "name": "Modules & .testform",
          "icon": "$(package)"
        },
        {
          "id": "testform.views.reports",
          "name": "Reports & Analytics",
          "icon": "$(graph)"
        }
      ]
    },
    "commands": [
      {
        "command": "testform.menu",
        "title": "Testform: Open Control Center Menu",
        "category": "Testform",
        "icon": "$(beaker)"
      },
      {
        "command": "testform.init",
        "title": "Testform: Initialize Workspace (init)",
        "category": "Testform",
        "icon": "$(repo-clone)"
      },
      {
        "command": "testform.validate",
        "title": "Testform: Validate Configuration & Scopes",
        "category": "Testform",
        "icon": "$(check)"
      },
      {
        "command": "testform.plan",
        "title": "Testform: Speculative Plan (plan)",
        "category": "Testform",
        "icon": "$(git-compare)"
      },
      {
        "command": "testform.apply",
        "title": "Testform: Apply Changes (apply)",
        "category": "Testform",
        "icon": "$(play)"
      },
      {
        "command": "testform.diff",
        "title": "Testform: Show State Drift (diff)",
        "category": "Testform",
        "icon": "$(diff)"
      },
      {
        "command": "testform.show",
        "title": "Testform: Inspect State or Plan (show)",
        "category": "Testform",
        "icon": "$(eye)"
      },
      {
        "command": "testform.providers",
        "title": "Testform: Show Providers Tree (providers)",
        "category": "Testform",
        "icon": "$(list-tree)"
      },
      {
        "command": "testform.modules.list",
        "title": "Testform: List Declared Modules (modules)",
        "category": "Testform",
        "icon": "$(package)"
      },
      {
        "command": "testform.report",
        "title": "Testform: Generate Report",
        "category": "Testform",
        "icon": "$(file-text)"
      },
      {
        "command": "testform.state.refresh",
        "title": "Testform: Refresh State Explorer",
        "category": "Testform",
        "icon": "$(refresh)"
      },
      {
        "command": "testform.modules.update",
        "title": "Testform: Update Modules (init)",
        "category": "Testform",
        "icon": "$(cloud-download)"
      },
      {
        "command": "testform.format",
        "title": "Testform: Format Document",
        "category": "Testform"
      },
      {
        "command": "testform.state.inspectResource",
        "title": "Inspect Resource (JSON)",
        "category": "Testform",
        "icon": "$(json)"
      },
      {
        "command": "testform.state.showResource",
        "title": "Testform: Show Resource CLI Details",
        "category": "Testform",
        "icon": "$(terminal)"
      },
      {
        "command": "testform.specs.openHub",
        "title": "Testform: Open Test Cases, Runs & Plans Hub",
        "category": "Testform",
        "icon": "$(layout-sidebar-right-off)"
      },
      {
        "command": "testform.state.taint",
        "title": "Taint Resource",
        "category": "Testform",
        "icon": "$(warning)"
      },
      {
        "command": "testform.state.untaint",
        "title": "Untaint Resource",
        "category": "Testform",
        "icon": "$(check)"
      },
      {
        "command": "testform.state.rm",
        "title": "Remove Resource from State",
        "category": "Testform",
        "icon": "$(trash)"
      },
      {
        "command": "testform.state.forceUnlock",
        "title": "Testform: Force Unlock State",
        "category": "Testform",
        "icon": "$(unlock)"
      },
      {
        "command": "testform.workspace.select",
        "title": "Testform: Select Workspace",
        "category": "Testform",
        "icon": "$(layers)"
      },
      {
        "command": "testform.modules.refresh",
        "title": "Testform: Refresh Modules & .testform",
        "category": "Testform",
        "icon": "$(refresh)"
      },
      {
        "command": "testform.applyCurrent",
        "title": "Testform: Run Apply Current Feature",
        "category": "Testform",
        "icon": "$(play)"
      },
      {
        "command": "testform.planCurrent",
        "title": "Testform: Speculative Plan Current Feature",
        "category": "Testform",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "testform.specs.openHub",
          "when": "view == testform.views.state || view == testform.views.modules || view == testform.views.reports",
          "group": "navigation@0"
        },
        {
          "command": "testform.state.refresh",
          "when": "view == testform.views.state",
          "group": "navigation@1"
        },
        {
          "command": "testform.state.forceUnlock",
          "when": "view == testform.views.state",
          "group": "navigation@2"
        },
        {
          "command": "testform.report",
          "when": "view == testform.views.reports",
          "group": "navigation"
        },
        {
          "command": "testform.modules.refresh",
          "when": "view == testform.views.modules",
          "group": "navigation@1"
        },
        {
          "command": "testform.modules.update",
          "when": "view == testform.views.modules",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "testform.planCurrent",
          "when": "resourceExtname == .feature",
          "group": "navigation@1"
        },
        {
          "command": "testform.applyCurrent",
          "when": "resourceExtname == .feature",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "testform.state.inspectResource",
          "when": "view == testform.views.state && (viewItem == testformResource || viewItem == testformResourceTainted)",
          "group": "inline"
        },
        {
          "command": "testform.state.taint",
          "when": "view == testform.views.state && viewItem == testformResource",
          "group": "testformState@1"
        },
        {
          "command": "testform.state.untaint",
          "when": "view == testform.views.state && viewItem == testformResourceTainted",
          "group": "testformState@1"
        },
        {
          "command": "testform.state.showResource",
          "when": "view == testform.views.state && (viewItem == testformResource || viewItem == testformResourceTainted)",
          "group": "testformState@2"
        },
        {
          "command": "testform.state.rm",
          "when": "view == testform.views.state && (viewItem == testformResource || viewItem == testformResourceTainted)",
          "group": "testformState@3"
        }
      ],
      "editor/context": [
        {
          "command": "testform.plan",
          "when": "resourceExtname == .feature",
          "group": "testform@1"
        },
        {
          "command": "testform.apply",
          "when": "resourceExtname == .feature",
          "group": "testform@2"
        },
        {
          "command": "testform.diff",
          "when": "resourceExtname == .feature",
          "group": "testform@3"
        },
        {
          "command": "testform.validate",
          "when": "resourceExtname == .feature",
          "group": "testform@4"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Testform",
      "properties": {
        "testform.executablePath": {
          "type": "string",
          "default": "testform",
          "description": "Path to the testform CLI executable binary. Defaults to globally installed testform."
        },
        "testform.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Testform Gherkin formatter as the default document formatter for .feature files."
        },
        "testform.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time syntax, field and variable resolution diagnostics."
        },
        "testform.diagnostics.validateRequiredFields": {
          "type": "boolean",
          "default": true,
          "description": "Validate that all mandatory fields configured in main.yml are specified in feature scenarios."
        },
        "testform.diagnostics.validateLooseTags": {
          "type": "boolean",
          "default": true,
          "description": "Report diagnostics errors for orphan or trailing @ tag prefixes missing a valid identifier."
        },
        "testform.completions.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable intelligent completions for Gherkin keywords, Testform DSL directives, and metadata."
        },
        "testform.completions.autoSpaceAfterEquals": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert a leading space when completing field values immediately following =."
        },
        "testform.testController.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable native VS Code Test Controller integration (Test Explorer tree and gutter run icons)."
        },
        "testform.testController.autoPrune": {
          "type": "boolean",
          "default": true,
          "description": "Automatically prune obsolete test items on file edits to maintain tree consistency."
        },
        "testform.testrun.targetFormat": {
          "type": "string",
          "enum": [
            "short",
            "classic"
          ],
          "enumDescriptions": [
            "Short identity tag (@tc-01)",
            "Classic canonical address (e.g. Magento/cart.case.feature.@tc-01)"
          ],
          "default": "short",
          "description": "Target insertion format for scenario targets inside Testrun rules."
        },
        "testform.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Testform Language Server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.0.3"
  }
}
