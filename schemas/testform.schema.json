{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testform Configuration Manifest",
  "description": "Configuration schema for Testform declarative Test-as-Code manifests (main.yml, main.yaml, testform.yml, testform.yaml)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Manifest schema version (e.g. \"1.0\")",
      "default": "1.0"
    },
    "testform": {
      "type": "object",
      "description": "Testform core engine configuration",
      "properties": {
        "required_version": {
          "type": "string",
          "description": "Version constraint string (e.g. >= 1.0.0)"
        },
        "required_providers": {
          "type": "object",
          "description": "Required provider dependencies and version constraints (Terraform parity)",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "description": "Source path or package (e.g. git::https://..., @org/provider, ./local.ts)"
              },
              {
                "type": "object",
                "properties": {
                  "source": { "type": "string", "description": "Git URL, NPM package, or local path" },
                  "version": { "type": "string", "description": "Version constraint (e.g. >= 1.0.0, ~> 1.2)" },
                  "constraints": { "type": "string", "description": "Optional additional version constraints" }
                },
                "required": ["source"]
              }
            ]
          }
        },
        "backend": {
          "description": "Backend state storage configuration (string identifier or object with properties)",
          "oneOf": [
            {
              "type": "string",
              "enum": ["local", "s3", "gcs", "azurerm", "http", "github", "oci", "rest", "custom"]
            },
            {
              "type": "object",
              "properties": {
                "local": {
                  "type": "object",
                  "description": "Local offline state ledger (zero configuration)",
                  "properties": {
                    "path": { "type": "string", "default": "testform.state" }
                  }
                },
                "s3": {
                  "type": "object",
                  "description": "AWS S3 state ledger with DynamoDB state locking",
                  "properties": {
                    "bucket": { "type": "string", "description": "S3 bucket name" },
                    "key": { "type": "string", "description": "State file path in S3", "default": "testform.state" },
                    "region": { "type": "string", "description": "AWS region (e.g. us-east-1)" },
                    "dynamodb_table": { "type": "string", "description": "DynamoDB table name for state locking" },
                    "endpoint": { "type": "string", "description": "Custom S3 endpoint URL (MinIO, LocalStack)" },
                    "profile": { "type": "string", "description": "AWS credentials profile" },
                    "encrypt": { "type": "boolean", "description": "Enable server-side encryption" },
                    "forcePathStyle": { "type": "boolean", "description": "Force path style S3 URLs" }
                  },
                  "required": ["bucket", "key"]
                },
                "azurerm": {
                  "type": "object",
                  "description": "Azure Blob Storage state ledger with blob lease locking",
                  "properties": {
                    "storage_account_name": { "type": "string", "description": "Azure Storage account name" },
                    "container_name": { "type": "string", "description": "Blob container name" },
                    "key": { "type": "string", "description": "Blob key name", "default": "testform.state" },
                    "resource_group_name": { "type": "string", "description": "Azure Resource Group name" },
                    "connection_string": { "type": "string", "description": "Optional storage connection string" }
                  },
                  "required": ["storage_account_name", "container_name", "key"]
                },
                "gcs": {
                  "type": "object",
                  "description": "Google Cloud Storage state ledger",
                  "properties": {
                    "bucket": { "type": "string", "description": "GCS bucket name" },
                    "prefix": { "type": "string", "description": "GCS object path prefix", "default": "state" },
                    "credentials": { "type": "string", "description": "Path to service account credentials JSON" }
                  },
                  "required": ["bucket"]
                },
                "oci": {
                  "type": "object",
                  "description": "Oracle Cloud Infrastructure Object Storage state ledger",
                  "properties": {
                    "bucket": { "type": "string", "description": "OCI bucket name" },
                    "namespace": { "type": "string", "description": "OCI Object Storage tenancy namespace" },
                    "key": { "type": "string", "description": "Object key name", "default": "testform.state" },
                    "compartment_id": { "type": "string", "description": "OCI compartment OCID" },
                    "region": { "type": "string", "description": "OCI region identifier" }
                  },
                  "required": ["bucket", "namespace", "key"]
                },
                "github": {
                  "type": "object",
                  "description": "GitHub Repository state ledger (persists state in branch)",
                  "properties": {
                    "branch": { "type": "string", "description": "Branch name for state storage", "default": "testform-state" },
                    "path": { "type": "string", "description": "File path in repository", "default": "state/testform.state" },
                    "token_env": { "type": "string", "description": "Environment variable holding GitHub token", "default": "GITHUB_TOKEN" },
                    "owner": { "type": "string", "description": "GitHub repository owner" },
                    "repository": { "type": "string", "description": "GitHub repository name" }
                  }
                },
                "http": {
                  "type": "object",
                  "description": "HTTP REST state ledger with lock/unlock endpoints",
                  "properties": {
                    "address": { "type": "string", "description": "HTTP GET/POST URL for state" },
                    "lock_address": { "type": "string", "description": "HTTP POST/PUT URL for lock" },
                    "unlock_address": { "type": "string", "description": "HTTP DELETE URL for unlock" },
                    "username": { "type": "string", "description": "HTTP basic auth username" },
                    "password": { "type": "string", "description": "HTTP basic auth password" },
                    "headers": { "type": "object", "description": "Custom HTTP request headers" }
                  },
                  "required": ["address"]
                }
              }
            }
          ]
        }
      }
    },
    "required_providers": {
      "$ref": "#/properties/testform/properties/required_providers"
    },
    "backend": {
      "$ref": "#/properties/testform/properties/backend"
    },
    "provider": {
      "description": "Configured execution or sync provider. Can be a string identifier ('local', 'github', 'gitlab') or configuration object with provider properties.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["local", "github", "gitlab"],
          "default": "local"
        },
        {
          "type": "object",
          "properties": {
            "local": {
              "type": "object",
              "description": "Local offline execution provider (zero configuration)"
            },
            "github": {
              "type": "object",
              "description": "GitHub Projects & Issues provider",
              "properties": {
                "owner": { "type": "string", "description": "GitHub repository owner or organization" },
                "repo": { "type": "string", "description": "GitHub repository name" },
                "repository": { "type": "string", "description": "Alias for repository name" },
                "project_number": { "type": "integer", "description": "GitHub Projects V2 board number" },
                "project_id": { "type": "string", "description": "GitHub Projects V2 node ID" },
                "token_env": { "type": "string", "default": "GITHUB_TOKEN" }
              },
              "required": ["owner", "repository"]
            },
            "gitlab": {
              "type": "object",
              "description": "GitLab Issues provider",
              "properties": {
                "project_id": { "type": "string", "description": "GitLab numeric project ID or URL-encoded path" },
                "projectId": { "type": "string", "description": "GitLab numeric project ID or URL-encoded path" },
                "host": { "type": "string", "default": "https://gitlab.com", "description": "GitLab host URL (optional, defaults to https://gitlab.com)" },
                "base_url": { "type": "string", "description": "GitLab API base URL" },
                "token_env": { "type": "string", "default": "GITLAB_TOKEN" },
                "tokenEnv": { "type": "string", "default": "GITLAB_TOKEN" }
              },
              "anyOf": [
                { "required": ["project_id"] },
                { "required": ["projectId"] }
              ],
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "variable": {
      "type": "object",
      "description": "Input variable declarations",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "list", "map"],
                "default": "string"
              },
              "description": { "type": "string" },
              "default": {},
              "sensitive": {
                "type": "boolean",
                "default": false,
                "description": "Mask variable value in logs and CLI output"
              },
              "enum": { "type": "array" },
              "validation": {
                "type": "object",
                "properties": {
                  "condition": { "type": "string" },
                  "error_message": { "type": "string" }
                },
                "required": ["condition", "error_message"]
              }
            }
          },
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "array" }
        ]
      }
    },
    "variables": { "$ref": "#/properties/variable" },
    "vars": { "$ref": "#/properties/variable" },
    "locals": {
      "type": "object",
      "description": "Local computed values evaluated within expressions (e.g. base_url: \"${var.app_url}\")",
      "additionalProperties": true
    },
    "local": { "$ref": "#/properties/locals" },
    "resource": {
      "type": "object",
      "description": "Resource scope mapping, directory structure, and custom fields",
      "properties": {
        "testcase": {
          "type": "object",
          "description": "TestCase pure BDD specification settings (Given, When, Then steps and metadata fields)",
          "properties": {
            "directory": { "type": "string", "default": "testcase", "description": "Target directory on disk where testcase specifications live" },
            "filename": { "type": "string", "default": "{slug}_{YYYYMMDD}.case.feature", "description": "Filename pattern for scaffolding with 'testform spec new'" },
            "match": { "type": "string", "default": "*.case.feature", "description": "Glob pattern for matching testcase feature files" },
            "identity": {
              "type": "string",
              "default": "tc-*",
              "description": "Identity tag pattern for testcase scenarios (e.g. 'tc-*' or 'custom-*')"
            },
            "fields": { "type": ["array", "object"], "description": "Custom metadata fields definition" }
          }
        },
        "testrun": {
          "type": "object",
          "description": "TestRun execution suite settings and runtime marks",
          "properties": {
            "directory": { "type": "string", "default": "testruns", "description": "Target directory on disk where testrun specifications live" },
            "filename": { "type": "string", "default": "{slug}_{YYYYMMDD}.run.feature", "description": "Filename pattern for scaffolding with 'testform spec new'" },
            "match": { "type": "string", "default": "*.run.feature", "description": "Glob pattern for matching testrun feature files" },
            "identity": {
              "type": "string",
              "default": "tr-*",
              "description": "Identity tag pattern for testrun scenarios (e.g. 'tr-*')"
            },
            "set": {
              "type": "object",
              "description": "Configuration for Gherkin runtime execution marks (* set ...)",
              "properties": {
                "status": {
                  "type": "object",
                  "description": "Semantic status categorization for testrun rollup and verdict calculation",
                  "properties": {
                    "success": { "type": ["array", "string"], "description": "Statuses that count as passed (approving the suite)" },
                    "failure": { "type": ["array", "string"], "description": "Statuses that count as failed (marking the suite as failed)" },
                    "pending": { "type": ["array", "string"], "description": "Statuses that keep the suite in progress" },
                    "skipped": { "type": ["array", "string"], "description": "Statuses for skipped or omitted cases" }
                  }
                },
                "attach": {
                  "type": "string",
                  "description": "Directory for testrun execution logs & attachments (* set attach = ...)"
                },
                "trace": { "type": ["object", "boolean"], "description": "Error trace options" },
                "duration": { "type": ["object", "string"], "description": "Duration options" }
              }
            },
            "fields": { "type": ["array", "object"], "description": "Custom metadata fields definition" }
          }
        },
        "testplan": {
          "type": "object",
          "description": "TestPlan master plan settings and execution coordination",
          "properties": {
            "directory": { "type": "string", "default": "testplans", "description": "Target directory on disk where testplan specifications live" },
            "filename": { "type": "string", "default": "{slug}_{YYYYMMDD}.plan.feature", "description": "Filename pattern for scaffolding with 'testform spec new'" },
            "match": { "type": "string", "default": "*.plan.feature", "description": "Glob pattern for matching testplan feature files" },
            "identity": {
              "type": "string",
              "default": "tp-*",
              "description": "Identity tag pattern for testplan scenarios (e.g. 'tp-*')"
            },
            "set": {
              "type": "object",
              "description": "Configuration for Gherkin runtime execution marks (* set ...)",
              "properties": {
                "attach": {
                  "type": "string",
                  "description": "Directory for testplan attachments (* set attach = ...)"
                }
              }
            },
            "fields": { "type": ["array", "object"], "description": "Custom metadata fields definition" }
          }
        },
        "bug": {
          "type": "object",
          "description": "Bug defect specification settings and lifecycle marks",
          "properties": {
            "directory": { "type": "string", "default": "bugs", "description": "Target directory on disk where bug specifications live" },
            "filename": { "type": "string", "default": "{slug}_{YYYYMMDD}.bug.feature", "description": "Filename pattern for scaffolding with 'testform spec new'" },
            "match": { "type": "string", "default": "*.bug.feature", "description": "Glob pattern for matching bug feature files" },
            "identity": {
              "type": "string",
              "default": "bg-*",
              "description": "Identity tag pattern for bug scenarios (e.g. 'bg-*')"
            },
            "set": {
              "type": "object",
              "description": "Configuration for Gherkin runtime execution marks (* set ...)",
              "properties": {
                "status": {
                  "type": "object",
                  "description": "Semantic status categorization for defect lifecycle and remote issue states",
                  "properties": {
                    "open": { "type": ["array", "string"], "description": "Statuses that map to open issue state (e.g. open, nuevo, reportado)" },
                    "in_progress": { "type": ["array", "string"], "description": "Statuses that map to in-progress open issue state" },
                    "resolved": { "type": ["array", "string"], "description": "Statuses that map to closed issue state (ready for retest)" },
                    "closed": { "type": ["array", "string"], "description": "Statuses that map to closed issue state (verified and closed)" }
                  }
                },
                "attach": {
                  "type": "string",
                  "description": "Directory for defect screenshots & attachments (* set attach = ...)"
                },
                "trace": { "type": ["object", "boolean"], "description": "Defect stack trace options" }
              }
            },
            "fields": { "type": ["array", "object"], "description": "Custom metadata fields definition" }
          }
        },
        "global": {
          "type": "object",
          "description": "Global definitions across all resources",
          "properties": {
            "set": {
              "type": "object",
              "description": "Global execution mark defaults",
              "properties": {
                "attach": {
                  "type": "string",
                  "description": "Default directory for attachments across all execution scopes"
                }
              }
            },
            "fields": { "type": ["array", "object"], "description": "Global fields definition across all scopes" }
          }
        }
      }
    },
    "scopes": { "$ref": "#/properties/resource" },
    "data": {
      "type": "object",
      "description": "Data sources declarations (fixtures or state resource aliases)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path to JSON or YAML fixture file (e.g. fixtures/users.json)"
          },
          "address": {
            "type": "string",
            "description": "Address of an existing state resource (e.g. auth/login.case.feature.@tc-1)"
          },
          "repository": { "type": "string" },
          "filter": { "type": "object" }
        }
      }
    },
    "module": {
      "type": "object",
      "description": "Reusable Testform feature modules",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Path to feature file or directory (e.g. auth/login.case.feature)"
          },
          "scenario": {
            "type": "string",
            "description": "Optional scenario identity tag or title filter (e.g. @tc-1)"
          },
          "vars": {
            "type": "object",
            "description": "Input parameters passed into the module"
          },
          "outputs": {
            "type": "object",
            "description": "Exported outputs from the module",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": { "type": "string", "description": "Expression or value (e.g. ${testcase.auth/login.case.feature.@tc-1.title})" },
                "description": { "type": "string" }
              },
              "required": ["value"]
            }
          }
        },
        "required": ["source"]
      }
    },
    "modules": { "$ref": "#/properties/module" },
    "outputs": {
      "type": "object",
      "description": "Root outputs accessible via 'testform output'",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Value or expression to output (e.g. ${var.env}, ${module.auth_module.login_title})",
            "type": ["string", "number", "boolean", "array", "object"]
          },
          "description": { "type": "string" },
          "sensitive": { "type": "boolean", "default": false }
        },
        "required": ["value"]
      }
    },
    "output": { "$ref": "#/properties/outputs" },
    "policy": {
      "type": "object",
      "description": "Governance and quality gate policy rules"
    }
  }
}
