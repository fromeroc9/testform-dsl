{
  "Testform Root Manifest Template": {
    "prefix": "tf-init-manifest",
    "body": [
      "version: \"1.0\"",
      "provider: local",
      "backend: local",
      "",
      "variable:",
      "  ${1:app_url}:",
      "    type: string",
      "    description: \"${2:Base application URL}\"",
      "    default: \"${3:https://example.com}\"",
      "",
      "locals:",
      "  ${4:base_url}: \"\\${var.${1:app_url}}\"",
      "",
      "resource:",
      "  testcase:",
      "    directory: \"testcase\"",
      "    filename: \"{slug}.case.feature\"",
      "    match: \"*.case.feature\"",
      "    identity: \"tc-*\"",
      "    fields: {}",
      "  testrun:",
      "    directory: \"testruns\"",
      "    filename: \"{slug}.run.feature\"",
      "    match: \"*.run.feature\"",
      "    identity: \"tr-*\"",
      "    set:",
      "      status:",
      "        success: [\"passed\", \"exitoso\"]",
      "        failure: [\"failed\", \"fallido\"]",
      "      attach: \"attachments/runs\"",
      "    fields: {}",
      "  testplan:",
      "    directory: \"testplans\"",
      "    filename: \"{slug}.plan.feature\"",
      "    match: \"*.plan.feature\"",
      "    identity: \"tp-*\"",
      "    set:",
      "      attach: \"attachments/plans\"",
      "    fields: {}"
    ],
    "description": "Scaffold a complete Testform root main.yml manifest (v1.1.0-beta.2 format)"
  }
}
