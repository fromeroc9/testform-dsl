{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(Feature|Característica|Funcionalidad|Rule|Regla|Background|Antecedentes|Contexto|Scenario|Escenario|Scenario Outline|Esquema del escenario|Examples?|Ejemplos?)\\s*:.*$",
    "decreaseIndentPattern": "^\\s*(Feature|Característica|Funcionalidad|Rule|Regla|Background|Antecedentes|Contexto|Scenario|Escenario|Scenario Outline|Esquema del escenario|Examples?|Ejemplos?)\\s*:.*$"
  }
}
