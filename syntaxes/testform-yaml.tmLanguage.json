{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Testform YAML",
  "scopeName": "source.testform.yaml",
  "patterns": [
    {
      "name": "comment.line.number-sign.yaml",
      "match": "#.*$"
    },
    {
      "name": "meta.interpolation.testform",
      "match": "\\$\\{([^}]+)\\}",
      "captures": {
        "0": { "name": "punctuation.definition.template-expression.begin.testform" },
        "1": {
          "patterns": [
            {
              "name": "variable.other.testform.var",
              "match": "\\bvar\\.[a-zA-Z0-9_]+"
            },
            {
              "name": "variable.other.testform.local",
              "match": "\\blocal\\.[a-zA-Z0-9_]+"
            },
            {
              "name": "variable.other.testform.data",
              "match": "\\bdata\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
            },
            {
              "name": "variable.other.testform.module",
              "match": "\\bmodule\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
            },
            {
              "name": "variable.other.testform.testcase",
              "match": "\\btestcase\\.[a-zA-Z0-9_./@-]+(\\.[a-zA-Z0-9_]+)*"
            },
            {
              "name": "support.function.testform",
              "match": "\\b(lower|upper|trim|replace|split|join|length|coalesce|default|jsonencode|jsondecode)\\b"
            }
          ]
        }
      }
    },
    {
      "name": "keyword.other.testform.key",
      "match": "^\\s*([a-zA-Z0-9_-]+)\\s*:"
    },
    {
      "name": "string.quoted.double.yaml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yaml",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.testform",
          "match": "\\$\\{([^}]+)\\}",
          "captures": {
            "0": { "name": "punctuation.definition.template-expression.begin.testform" },
            "1": {
              "patterns": [
                {
                  "name": "variable.other.testform.var",
                  "match": "\\bvar\\.[a-zA-Z0-9_]+"
                },
                {
                  "name": "variable.other.testform.local",
                  "match": "\\blocal\\.[a-zA-Z0-9_]+"
                },
                {
                  "name": "variable.other.testform.data",
                  "match": "\\bdata\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
                },
                {
                  "name": "variable.other.testform.module",
                  "match": "\\bmodule\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
                },
                {
                  "name": "variable.other.testform.testcase",
                  "match": "\\btestcase\\.[a-zA-Z0-9_./@-]+(\\.[a-zA-Z0-9_]+)*"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "string.quoted.single.yaml",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.yaml",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.language.boolean.yaml",
      "match": "\\b(true|false|yes|no|on|off)\\b"
    },
    {
      "name": "constant.numeric.yaml",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ]
}

