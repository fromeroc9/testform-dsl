{
  "scopeName": "testform.injection",
  "injectionSelector": "L:text.gherkin.feature, L:source.feature",
  "patterns": [
    {
      "include": "#expressions"
    },
    {
      "include": "#outline-params"
    },
    {
      "include": "#tags-special"
    },
    {
      "include": "#dsl-status"
    },
    {
      "include": "#dsl-field"
    }
  ],
  "repository": {
    "outline-params": {
      "patterns": [
        {
          "name": "variable.parameter.outline.gherkin",
          "match": "<[a-zA-Z0-9_.-]+>"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "meta.interpolation.testform",
          "match": "\\$\\{([^}]+)\\}",
          "captures": {
            "0": { "name": "punctuation.definition.template-expression.begin.testform" },
            "1": {
              "patterns": [
                {
                  "name": "variable.other.testform.var",
                  "match": "\\bvar\\.[a-zA-Z0-9_]+"
                },
                {
                  "name": "variable.other.testform.local",
                  "match": "\\blocal\\.[a-zA-Z0-9_]+"
                },
                {
                  "name": "variable.other.testform.data",
                  "match": "\\bdata\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
                },
                {
                  "name": "variable.other.testform.module",
                  "match": "\\bmodule\\.[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*"
                },
                {
                  "name": "variable.other.testform.state",
                  "match": "\\b(testcase|testrun|testplan)\\.[a-zA-Z0-9_./@-]+"
                },
                {
                  "name": "variable.other.testform.env",
                  "match": "\\benv\\.[a-zA-Z0-9_]+"
                },
                {
                  "name": "support.function.testform",
                  "match": "\\b(lower|upper|trim|trimprefix|trimsuffix|startswith|endswith|replace|split|join|format|substr|contains|coalesce|lookup|length|element|slice|merge|env|uuid|timestamp|jsonencode|jsondecode|file|abs|min|max|floor|ceil)\\b"
                },
                {
                  "name": "string.quoted.double.testform",
                  "match": "\"[^\"]*\""
                },
                {
                  "name": "constant.numeric.testform",
                  "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
                },
                {
                  "name": "constant.language.boolean.testform",
                  "match": "\\b(true|false)\\b"
                }
              ]
            }
          }
        }
      ]
    },
    "tags-special": {
      "patterns": [
        {
          "name": "entity.name.tag.scope.testform",
          "match": "@(testcase|testrun|testplan)\\b"
        },
        {
          "name": "entity.name.tag.identity.testform",
          "match": "@(tc|tr|tp)-[0-9a-zA-Z_-]+"
        },
        {
          "name": "entity.name.tag.directive.testform",
          "match": "@(module|depends_on|target)\\b"
        },
        {
          "name": "entity.name.tag.flag.testform",
          "match": "@(smoke|regression|critical|slow|flaky|e2e|auth|ui|api|security|performance|retry|timeout)\\b"
        }
      ]
    },
    "dsl-status": {
      "patterns": [
        {
          "match": "(^\\s*\\*\\s+)?\\b(mark)\\b\\s+\\b(status)\\b\\s*(=)\\s*\\b(passed|failed|skipped|blocked|pending|unexecuted)\\b",
          "captures": {
            "1": { "name": "keyword.control.step.gherkin" },
            "2": { "name": "keyword.control.testform.mark" },
            "3": { "name": "support.type.property-name.testform" },
            "4": { "name": "keyword.operator.assignment.testform" },
            "5": { "name": "constant.language.status.testform" }
          }
        }
      ]
    },
    "dsl-field": {
      "patterns": [
        {
          "match": "(^\\s*(?:\\*|Given|When|Then|And|Dado|Cuando|Entonces|Y)\\s+)?\\b(field)\\b\\s+([a-zA-Z0-9_.-]+)\\s*(=)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.control.step.gherkin" },
            "2": { "name": "keyword.control.testform.field" },
            "3": { "name": "variable.other.member.testform" },
            "4": { "name": "keyword.operator.assignment.testform" },
            "5": { "name": "string.unquoted.testform" }
          }
        }
      ]
    }
  }
}
